# 1. Copier ce fichier : cp env.example .env.local
# 2. Remplir les valeurs :
#    - générer AUTH_SECRET/SESSION_SECRET : openssl rand -base64 64
#    - hasher le mot de passe admin : node -e "console.log(require('bcrypt').hashSync('motdepasse', 12))"
# 3. NE JAMAIS COMMITTER .env.local

DOMAIN="localhost"
MAIL_CONTACT="contact@example.com"
# Default for local dev. When running under Docker Compose, this is overridden
# in docker-compose.yml to use the mongo service hostname.
MONGODB_URI="mongodb://user:password@localhost:27017"
MONGODB_DB="portfolio"
SESSION_SECRET=""
AUTH_EMAIL="admin@example.com"
AUTH_PASSWORD=""
# Clé secrète utilisée pour accéder à /auth/signin/[AUTH_SECRET]
# Gardez cette URL confidentielle (logs, historique, referrers)
AUTH_SECRET=""

# Resend configuration (https://resend.com) — required for the contact form
RESEND_API_KEY=""
RESEND_FROM_EMAIL="onboarding@resend.dev"

# Optional: override the CV download URL (defaults to /cv.pdf)
NEXT_PUBLIC_CV_URL=""
