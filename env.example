# 1. Copier ce fichier : cp env.example .env.local
# 2. Remplir les valeurs :
#    - générer SIGNIN_SECRET/SESSION_SECRET : openssl rand -base64 64
#    - hasher le mot de passe admin : node -e "console.log(require('bcrypt').hashSync('motdepasse', 12))"
# 3. NE JAMAIS COMMITTER .env.local

DOMAIN="localhost"
MAIL_CONTACT="contact@example.com"
# Default for local dev. When running under Docker Compose, this is overridden
# in docker-compose.yml to use the mongo service hostname.
MONGODB_URI="mongodb://user:password@localhost:27017"
MONGODB_DB="portfolio"
SESSION_SECRET=""
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD=""
# Clé secrète utilisée pour accéder à /auth/signin/[SIGNIN_SECRET]
# Gardez cette URL confidentielle (logs, historique, referrers)
SIGNIN_SECRET=""

# Resend configuration (https://resend.com) — required for the contact form
RESEND_API_KEY=""
RESEND_FROM_EMAIL="onboarding@resend.dev"

# Cloudflare R2 — required for image uploads (S3-compatible API, private)
R2_BUCKET_NAME=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_ENDPOINT=""

# Public R2 URL used to DISPLAY uploaded images (e.g. https://r2.hanbr.be).
# Must be a dedicated public R2 custom domain/subdomain — NOT the app domain
# and NOT the R2 API endpoint (<id>.r2.cloudflarestorage.com). Required.
R2_PUBLIC_URL=""

# Optional: override the CV download URL (defaults to /cv.pdf)
NEXT_PUBLIC_CV_URL=""

# Production site URL used for absolute URLs in metadata, sitemap, robots, OG.
# Leave empty in dev — DOMAIN will be used as fallback.
NEXT_PUBLIC_SITE_URL=""

# Google Search Console verification meta (optional).
# Get from https://search.google.com/search-console → Settings → Ownership → HTML tag
GOOGLE_SITE_VERIFICATION=""
